<Window
    x:Class="MusicUnlock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicUnlock"
    Title="音匣">
    <Grid x:Name="Root" Language="zh-CN" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="O" Invoked="OnAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Enter" Invoked="OnAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Without Mica or acrylic, and in preview renders (which only capture the XAML tree). -->
        <Border x:Name="SolidBackdrop" Grid.RowSpan="2" Background="{ThemeResource MuWorkspaceBrush}" Visibility="Collapsed" />
        <!-- Mirrors the macOS toolbar: workspace switcher in the middle, file actions on the right. -->
        <TitleBar x:Name="AppTitleBar" Title="音匣">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <local:GlassSwitch x:Name="WorkspaceBar" HorizontalAlignment="Center" Title="工作区"
                                   SelectionChanged="OnWorkspaceChanged" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Grid x:Name="HeaderActions">
                    <StackPanel x:Name="AudioActions" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                        <Button Click="OnAddFolder" Background="Transparent" BorderThickness="0" Padding="10,6"
                                ToolTipService.ToolTip="添加文件夹（Ctrl+Shift+O）" AutomationProperties.Name="添加文件夹"
                                AutomationProperties.AcceleratorKey="Ctrl+Shift+O">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                                <TextBlock Text="添加文件夹" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnAddFiles" Background="Transparent" BorderThickness="0" Padding="10,6"
                                ToolTipService.ToolTip="添加文件（Ctrl+O）" AutomationProperties.Name="添加文件"
                                AutomationProperties.AcceleratorKey="Ctrl+O">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="添加文件" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- Lyrics workspace actions (macOS: 打开歌词, 账号登录). -->
                    <StackPanel x:Name="LyricsActions" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" HorizontalAlignment="Right"
                                Visibility="Collapsed">
                        <Button Click="OnOpenLyrics" Background="Transparent" BorderThickness="0" Padding="10,6"
                                ToolTipService.ToolTip="打开本地 LRC 或 TXT（Ctrl+O）" AutomationProperties.Name="打开歌词">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="打开歌词" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AccountsButton" Click="OnAccounts" Background="Transparent" BorderThickness="0" Padding="10,6"
                                ToolTipService.ToolTip="官方登录后自动保存会话，无需手动获取 Cookie" AutomationProperties.Name="账号登录">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="AccountsIcon" Glyph="&#xE77B;" FontSize="14" />
                                <TextBlock Text="账号登录" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TitleBar.RightHeader>
        </TitleBar>
        <local:UnlockView x:Name="AudioView" Grid.Row="1" />
        <local:LyricsView x:Name="LyricsWorkspace" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
</Window>
