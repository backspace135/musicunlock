<Window
    x:Class="MusicUnlock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicUnlock"
    Title="音匣">
    <Grid x:Name="Root" Language="zh-CN" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="O" Invoked="OnAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Enter" Invoked="OnAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Without Mica or acrylic, and in preview renders (which only capture the XAML tree). -->
        <Border x:Name="SolidBackdrop" Grid.RowSpan="2" Background="{ThemeResource MuWorkspaceBrush}" Visibility="Collapsed" />
        <!-- Mirrors the macOS toolbar: workspace switcher in the middle, file actions on the right. -->
        <TitleBar x:Name="AppTitleBar" Title="音匣">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <SelectorBar x:Name="WorkspaceBar" HorizontalAlignment="Center" SelectionChanged="OnWorkspaceChanged"
                             AutomationProperties.Name="工作区">
                    <SelectorBarItem x:Name="AudioItem" Text="音乐解锁" IsSelected="True">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE785;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="LyricsItem" Text="歌词工具">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE8E4;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Grid x:Name="HeaderActions">
                    <!-- One glass capsule per group, icons only; the words stay in the tooltip and the narrator name. -->
                    <local:GlassSurface x:Name="AudioActions" Kind="Control" Radius="-1" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Click="OnAddFolder" Background="Transparent" BorderThickness="0" Width="36" Height="30" Padding="0"
                                    ToolTipService.ToolTip="添加文件夹（Ctrl+Shift+O）" AutomationProperties.Name="添加文件夹"
                                    AutomationProperties.AcceleratorKey="Ctrl+Shift+O" local:Press.Scale="0.96">
                                <FontIcon Glyph="&#xE8F4;" FontSize="13" Foreground="{ThemeResource MuTextBrush}" />
                            </Button>
                            <Button Click="OnAddFiles" Background="Transparent" BorderThickness="0" Width="36" Height="30" Padding="0"
                                    ToolTipService.ToolTip="添加文件（Ctrl+O）" AutomationProperties.Name="添加文件"
                                    AutomationProperties.AcceleratorKey="Ctrl+O" local:Press.Scale="0.96">
                                <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{ThemeResource MuTextBrush}" />
                            </Button>
                        </StackPanel>
                    </local:GlassSurface>
                    <!-- Lyrics workspace actions (macOS: 打开歌词, 账号登录). The account menu itself belongs to the glass menu. -->
                    <local:GlassSurface x:Name="LyricsActions" Kind="Control" Radius="-1" Margin="0,0,8,0"
                                        HorizontalAlignment="Right" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Button Click="OnOpenLyrics" Background="Transparent" BorderThickness="0" Width="36" Height="30" Padding="0"
                                    ToolTipService.ToolTip="打开本地 LRC 或 TXT（Ctrl+O）" AutomationProperties.Name="打开歌词"
                                    local:Press.Scale="0.96">
                                <FontIcon Glyph="&#xE8E5;" FontSize="13" Foreground="{ThemeResource MuTextBrush}" />
                            </Button>
                            <Button x:Name="AccountsButton" Click="OnAccounts" Background="Transparent" BorderThickness="0"
                                    Width="36" Height="30" Padding="0" ToolTipService.ToolTip="官方登录后自动保存会话，无需手动获取 Cookie"
                                    AutomationProperties.Name="账号登录" local:Press.Scale="0.96">
                                <FontIcon x:Name="AccountsIcon" Glyph="&#xE77B;" FontSize="13" Foreground="{ThemeResource MuTextBrush}" />
                            </Button>
                        </StackPanel>
                    </local:GlassSurface>
                </Grid>
            </TitleBar.RightHeader>
        </TitleBar>
        <local:UnlockView x:Name="AudioView" Grid.Row="1" />
        <local:LyricsView x:Name="LyricsWorkspace" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
</Window>
