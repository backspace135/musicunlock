<!-- Lyrics workspace, laid out like apps/macos LyricsView: search bar on top, 300 px checkable results on the
     left, the editor on the right and export actions in the footer. The only emphasis is the selected song's
     ink bar and the primary export button; state uses glyph + text, not colour. -->
<UserControl
    x:Class="MusicUnlock.LyricsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicUnlock">
    <UserControl.Resources>
        <Style x:Key="MuIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource MuSecondaryBrush}" />
        </Style>
        <Style x:Key="MuResultItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <FontFamily x:Key="MuLyricFont">Cascadia Mono, Consolas</FontFamily>
    </UserControl.Resources>

    <Grid Padding="{StaticResource MuPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <StackPanel Spacing="12">
            <Grid MinHeight="28">
                <TextBlock Text="歌词工作台" Style="{StaticResource MuPageTitleStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <FontIcon x:Name="SessionGlyph" Glyph="&#xE774;" FontSize="12" Foreground="{ThemeResource MuSecondaryBrush}" />
                    <TextBlock x:Name="SessionText" Text="公开内容可免登录读取" FontSize="11" Foreground="{ThemeResource MuSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ProviderBox" HorizontalAlignment="Stretch" AutomationProperties.Name="音乐来源"
                          SelectionChanged="OnProviderChanged" />
                <ComboBox x:Name="KindBox" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="搜索类型"
                          SelectionChanged="OnKindChanged" />
                <TextBox x:Name="QueryBox" Grid.Column="2" PlaceholderText="歌曲、歌手，或粘贴歌曲 / 歌单 / 专辑链接"
                         AutomationProperties.Name="歌词搜索关键词或音乐链接" TextChanged="OnQueryChanged" KeyDown="OnQueryKeyDown" />
                <Grid Grid.Column="3">
                    <Button x:Name="SearchButton" Style="{StaticResource AccentButtonStyle}" Padding="16,6" MinWidth="88" Click="OnSearch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                            <TextBlock Text="搜索" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelSearchButton" Padding="16,6" MinWidth="88" Visibility="Collapsed" Click="OnCancelSearch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                            <TextBlock Text="取消" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </StackPanel>

        <InfoBar x:Name="Notice" Grid.Row="1" Severity="Informational" IsOpen="False" IsClosable="True" Closed="OnNoticeClosed" />

        <Grid Grid.Row="2" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <!-- 300 px results column (DESIGN.md) -->
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Results -->
            <Border Style="{StaticResource MuPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="14" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="ResultsTitle" Text="搜索结果" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ResultsSubtitle" FontSize="11" Foreground="{ThemeResource MuSecondaryBrush}" />
                        </StackPanel>
                        <HyperlinkButton x:Name="SelectAllButton" Grid.Column="1" Content="全选" FontSize="12" Padding="4,2"
                                         VerticalAlignment="Center" Visibility="Collapsed" Click="OnSelectAll" />
                    </Grid>
                    <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource MuSeparatorBrush}" />

                    <StackPanel x:Name="ResultsLoading" Grid.Row="2" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <ProgressRing IsActive="True" Width="24" Height="24" />
                        <TextBlock x:Name="ResultsLoadingText" FontSize="12" Foreground="{ThemeResource MuSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="ResultsEmpty" Grid.Row="2" Spacing="14" Padding="20" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE721;" FontSize="34" Foreground="{ThemeResource MuSecondaryBrush}" />
                        <TextBlock Text="先找到你想要的歌" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center" />
                        <TextBlock Text="输入名称搜索，或粘贴完整链接。&#x0a;歌单与专辑可以批量提取歌词。" FontSize="12" LineHeight="20"
                                   Foreground="{ThemeResource MuSecondaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ListView x:Name="ResultList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" Padding="0,4"
                              ItemClick="OnResultClicked" ItemContainerStyle="{StaticResource MuResultItemStyle}"
                              AutomationProperties.Name="歌词搜索结果" Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:LyricRow">
                                <Grid>
                                    <!-- The selected song: a faint tint and an ink bar, like the macOS highlight. -->
                                    <Border CornerRadius="10" Background="{ThemeResource MuChipBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                    <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="3,12" HorizontalAlignment="Left"
                                               Fill="{ThemeResource MuTextBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                    <Grid Padding="10,13" ColumnSpacing="6" Visibility="{x:Bind IsSong}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="查看歌词" Tag="{x:Bind Id}" Click="OnPreviewSong"
                                                                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" />
                                                <MenuFlyoutItem Text="{x:Bind CheckAction, Mode=OneWay}" Tag="{x:Bind Id}" Click="OnToggleSong"
                                                                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" />
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <CheckBox MinWidth="0" Padding="0" VerticalAlignment="Center" Tag="{x:Bind Id}" Click="OnToggleSong"
                                                  IsChecked="{x:Bind IsChecked, Mode=OneWay}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                                  AutomationProperties.Name="{x:Bind CheckLabel}" />
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource MuSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Album}" FontSize="10" Foreground="{ThemeResource MuSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Duration}" FontSize="10"
                                                           Foreground="{ThemeResource MuSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Padding="14" ColumnSpacing="10" Visibility="{x:Bind IsCollection}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="21" />
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource MuSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource MuSecondaryBrush}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.Footer>
                            <Button x:Name="LoadMoreButton" Content="加载更多" HorizontalAlignment="Center" Margin="16" Visibility="Collapsed"
                                    Click="OnLoadMore" />
                        </ListView.Footer>
                    </ListView>
                </Grid>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="1" Style="{StaticResource MuPanelStyle}">
                <Grid>
                    <StackPanel x:Name="EditorEmpty" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8E4;" FontSize="42" />
                        <TextBlock Text="让歌词跟上音乐" FontSize="22" FontWeight="Medium" HorizontalAlignment="Center" />
                        <TextBlock Text="选一首歌，查看原文、译文与罗马音。&#x0a;也能把歌词变成视频用的字幕。" FontSize="13" LineHeight="22"
                                   Foreground="{ThemeResource MuSecondaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEC4F;" FontSize="12" Foreground="{ThemeResource MuSecondaryBrush}" />
                                <TextBlock Text="LRC 歌词" FontSize="11" Foreground="{ThemeResource MuSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7F0;" FontSize="12" Foreground="{ThemeResource MuSecondaryBrush}" />
                                <TextBlock Text="SRT / VTT 字幕" FontSize="11" Foreground="{ThemeResource MuSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Grid x:Name="EditorPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Padding="18" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="SongTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="SongDetail" FontSize="12" Foreground="{ThemeResource MuSecondaryBrush}" TextWrapping="Wrap"
                                           MaxLines="2" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <Button x:Name="RetryButton" Grid.Column="1" Style="{StaticResource MuIconButtonStyle}" VerticalAlignment="Top"
                                    Click="OnRetryLyrics" ToolTipService.ToolTip="重新获取歌词，会替换当前编辑"
                                    AutomationProperties.Name="重新获取歌词">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                        <SelectorBar x:Name="EditorTabs" Grid.Row="1" Margin="12,0,12,8" SelectionChanged="OnTabChanged"
                                     AutomationProperties.Name="歌词编辑区域" />
                        <Rectangle Grid.Row="2" Height="1" Fill="{ThemeResource MuSeparatorBrush}" />

                        <StackPanel x:Name="LyricsLoading" Grid.Row="3" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <ProgressRing IsActive="True" Width="24" Height="24" />
                            <TextBlock Text="正在获取歌词…" FontSize="12" Foreground="{ThemeResource MuSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel x:Name="PreviewError" Grid.Row="3" Spacing="12" Padding="24" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE713;" FontSize="16" />
                                <TextBlock Text="检查导出设置" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock x:Name="PreviewErrorText" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource MuSecondaryBrush}" />
                        </StackPanel>

                        <ScrollViewer x:Name="PreviewScroll" Grid.Row="3" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                                      VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <TextBlock x:Name="PreviewText" Padding="18" FontFamily="{StaticResource MuLyricFont}" FontSize="12" LineHeight="20"
                                       IsTextSelectionEnabled="True" AutomationProperties.Name="导出预览" />
                        </ScrollViewer>

                        <TextBox x:Name="EditorBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="NoWrap" IsSpellCheckEnabled="False"
                                 FontFamily="{StaticResource MuLyricFont}" FontSize="13" Padding="18,14" BorderThickness="0"
                                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="OnEditorChanged">
                            <!-- Flat like the macOS text editor: no field chrome on hover or focus. -->
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                            </TextBox.Resources>
                        </TextBox>

                        <Rectangle Grid.Row="4" Height="1" Fill="{ThemeResource MuSeparatorBrush}" />
                        <Grid Grid.Row="5" Padding="14" ColumnSpacing="10">
                            <TextBlock x:Name="EditorHint" FontSize="11" Foreground="{ThemeResource MuSecondaryBrush}" />
                            <TextBlock x:Name="LineCount" FontSize="11" Foreground="{ThemeResource MuSecondaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
