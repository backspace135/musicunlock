<!-- 账号登录 (macOS MusicLoginSheet and the 账号登录 menu): one dialog, one tab per platform. NetEase signs in by
     native QR code (or its official page), QQ Music by its official page in WebView2. A saved session shows the
     nickname and "会话已保存", never "permanently signed in". State uses glyph + text, not colour. -->
<ContentDialog
    x:Class="MusicUnlock.AccountsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicUnlock"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="账号登录"
    CloseButtonText="完成"
    DefaultButton="Close"
    Language="zh-CN">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
    </ContentDialog.Resources>

    <Grid Width="660" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="在官方页面授权，音匣自动保存登录，无需复制 Cookie。" Style="{StaticResource MuCaptionStyle}" />
        <local:GlassSwitch x:Name="ProviderBar" Grid.Row="1" Title="音乐平台" OnGlass="True"
                           SelectionChanged="OnProviderChanged" />

        <!-- Height follows the window (FitToWindow) so the footer never scrolls away. -->
        <Grid x:Name="ContentArea" Grid.Row="2" Height="410">
            <!-- Saved session -->
            <StackPanel x:Name="SessionPanel" Visibility="Collapsed" Spacing="10" HorizontalAlignment="Center"
                        VerticalAlignment="Center" MaxWidth="420">
                <Grid HorizontalAlignment="Center" Width="72" Height="72" Margin="0,0,0,6">
                    <Ellipse Fill="{ThemeResource MuChipBrush}" Stroke="{ThemeResource MuSeparatorBrush}" StrokeThickness="1" />
                    <FontIcon Glyph="&#xE77B;" FontSize="30" Foreground="{ThemeResource MuTextBrush}" />
                    <Border Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{ThemeResource MuTextBrush}">
                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource MuWorkspaceBrush}" />
                    </Border>
                </Grid>
                <TextBlock x:Name="SessionTitle" Style="{StaticResource MuSectionTitleStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="AccountText" FontSize="13" Foreground="{ThemeResource MuTextBrush}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" IsTextSelectionEnabled="True"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Style="{StaticResource MuCaptionStyle}" TextAlignment="Center"
                           Text="会话的有效期由平台决定。如果歌词搜索提示需要登录，请重新登录。" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="ReloginButton" Content="重新登录" Click="OnRelogin" />
                    <Button x:Name="LogoutButton" Click="OnLogout" />
                </StackPanel>
            </StackPanel>

            <!-- NetEase QR code -->
            <StackPanel x:Name="QrPanel" Visibility="Collapsed" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Always black on white so phones can scan it, in every theme. -->
                <Grid Width="232" Height="232" HorizontalAlignment="Center">
                    <Border Background="White" CornerRadius="12" BorderBrush="{ThemeResource MuSeparatorBrush}" BorderThickness="1"
                            Padding="16">
                        <Path x:Name="QrPath" Fill="Black" Stretch="Uniform" AutomationProperties.Name="网易云音乐登录二维码" />
                    </Border>
                    <Border x:Name="QrCover" Background="White" Opacity="0.94" CornerRadius="11" Margin="1" Visibility="Collapsed" />
                    <FontIcon x:Name="QrCoverIcon" FontSize="44" Foreground="Black" Visibility="Collapsed" />
                    <ProgressRing x:Name="QrProgress" IsActive="False" Width="40" Height="40" Foreground="Black" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon x:Name="QrStatusIcon" FontSize="16" Foreground="{ThemeResource MuTextBrush}" />
                    <TextBlock x:Name="QrStatusText" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource MuTextBrush}"
                               TextWrapping="Wrap" MaxWidth="440" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock Text="打开手机网易云音乐，使用扫一扫并确认登录。" Style="{StaticResource MuCaptionStyle}"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button x:Name="RefreshQrButton" Click="OnRefreshQr" />
                    <Button Content="使用官方登录页" Click="OnOfficialPage" />
                </StackPanel>
            </StackPanel>

            <!-- Official login page -->
            <Grid x:Name="WebPanel" Visibility="Collapsed">
                <Border x:Name="WebHost" CornerRadius="8" BorderBrush="{ThemeResource MuSeparatorBrush}" BorderThickness="1"
                        Background="{ThemeResource MuSurfaceBrush}" />
                <StackPanel x:Name="WebStatus" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                    <ProgressRing x:Name="WebProgress" IsActive="True" Width="32" Height="32" />
                    <FontIcon x:Name="WebStatusIcon" Glyph="&#xE7BA;" FontSize="24" Visibility="Collapsed"
                              Foreground="{ThemeResource MuTextBrush}" />
                    <TextBlock x:Name="WebStatusText" Text="正在打开官方登录页…" FontSize="13" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{ThemeResource MuTextBrush}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12" MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="FooterIcon" Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource MuSecondaryBrush}"
                      VerticalAlignment="Center" />
            <TextBlock x:Name="FooterText" Grid.Column="1" Style="{StaticResource MuSmallCaptionStyle}" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ReloadPageButton" Content="刷新页面" Click="OnReloadPage" Visibility="Collapsed" />
                <Button x:Name="NativeQrButton" Content="改用原生扫码" Click="OnNativeQr" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
