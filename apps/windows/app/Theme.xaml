<!-- Design tokens from apps/macos/DESIGN.md: black, white and grey only (R = G = B), no colour accent.
     State is shown by glyph and text, never by hue. The system accent is overridden with the ink grey,
     so default controls (primary buttons, selection, focus) follow the same palette. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="MuWorkspaceColor">#F2F2F2</Color>
            <Color x:Key="MuSurfaceColor">#FAFAFA</Color>
            <Color x:Key="MuTextColor">#1C1C1C</Color>
            <Color x:Key="MuSecondaryColor">#636363</Color>
            <Color x:Key="MuSeparatorColor">#E0E0E0</Color>
            <SolidColorBrush x:Key="MuWorkspaceBrush" Color="#F2F2F2" />
            <!-- Solid white cards on a light grey window; no material behind them. -->
            <SolidColorBrush x:Key="MuSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MuPanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MuTextBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="MuSecondaryBrush" Color="#636363" />
            <SolidColorBrush x:Key="MuSeparatorBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="MuChipBrush" Color="#1C1C1C" Opacity="0.055" />
            <SolidColorBrush x:Key="MuRunningRowBrush" Color="#1C1C1C" Opacity="0.06" />
            <SolidColorBrush x:Key="MuDropBrush" Color="#1C1C1C" Opacity="0.08" />
            <SolidColorBrush x:Key="MuProminentBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="MuProminentTextBrush" Color="#FFFFFF" />
            <!-- A disabled primary button keeps its ink; only the text fades, so it never vanishes into the panel. -->
            <SolidColorBrush x:Key="MuProminentDisabledBrush" Color="#1C1C1C" />
            <Color x:Key="SystemAccentColor">#1C1C1C</Color>
            <Color x:Key="SystemAccentColorLight1">#1C1C1C</Color>
            <Color x:Key="SystemAccentColorLight2">#1C1C1C</Color>
            <Color x:Key="SystemAccentColorLight3">#1C1C1C</Color>
            <Color x:Key="SystemAccentColorDark1">#1C1C1C</Color>
            <Color x:Key="SystemAccentColorDark2">#3A3A3A</Color>
            <Color x:Key="SystemAccentColorDark3">#4A4A4A</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="MuWorkspaceColor">#1E1E1E</Color>
            <Color x:Key="MuSurfaceColor">#282828</Color>
            <Color x:Key="MuTextColor">#F2F2F2</Color>
            <Color x:Key="MuSecondaryColor">#A0A0A0</Color>
            <Color x:Key="MuSeparatorColor">#3A3A3A</Color>
            <SolidColorBrush x:Key="MuWorkspaceBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="MuSurfaceBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="MuPanelBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="MuTextBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="MuSecondaryBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="MuSeparatorBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="MuChipBrush" Color="#F2F2F2" Opacity="0.07" />
            <SolidColorBrush x:Key="MuRunningRowBrush" Color="#F2F2F2" Opacity="0.06" />
            <SolidColorBrush x:Key="MuDropBrush" Color="#F2F2F2" Opacity="0.08" />
            <SolidColorBrush x:Key="MuProminentBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="MuProminentTextBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="MuProminentDisabledBrush" Color="#F2F2F2" />
            <Color x:Key="SystemAccentColor">#F2F2F2</Color>
            <Color x:Key="SystemAccentColorLight1">#E6E6E6</Color>
            <Color x:Key="SystemAccentColorLight2">#F2F2F2</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFFFF</Color>
            <Color x:Key="SystemAccentColorDark1">#D0D0D0</Color>
            <Color x:Key="SystemAccentColorDark2">#B0B0B0</Color>
            <Color x:Key="SystemAccentColorDark3">#909090</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="MuWorkspaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MuSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MuPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MuTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MuSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MuSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MuChipBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MuRunningRowBrush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.2" />
            <SolidColorBrush x:Key="MuDropBrush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.2" />
            <SolidColorBrush x:Key="MuProminentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MuProminentTextBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MuProminentDisabledBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 4/8 px spacing; main area 24 px margins (DESIGN.md). -->
    <CornerRadius x:Key="MuPanelRadius">20</CornerRadius>
    <CornerRadius x:Key="MuFooterRadius">22</CornerRadius>
    <Thickness x:Key="MuPagePadding">24,20,24,0</Thickness>

    <Style x:Key="MuPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MuPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuPanelRadius}" />
    </Style>
    <Style x:Key="MuPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MuTextBrush}" />
    </Style>
    <Style x:Key="MuSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MuTextBrush}" />
    </Style>
    <Style x:Key="MuLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource MuTextBrush}" />
    </Style>
    <Style x:Key="MuCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource MuSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style x:Key="MuSmallCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource MuCaptionStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <!-- Capsule buttons (macOS controlSize .large): 30 tall, 14 horizontal padding, 13 Medium. The corner radius
         is half the height, so the shape stays a capsule as the button grows with its label. -->
    <Style x:Key="MuCapsuleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Primary: solid ink, white text in light, black text in dark. No border. -->
    <Style x:Key="MuProminentButtonStyle" TargetType="Button" BasedOn="{StaticResource MuCapsuleButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource MuProminentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource MuProminentTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Plate.Background" Value="{ThemeResource MuProminentDisabledBrush}" />
                                        <Setter Target="Plate.Opacity" Value="0.45" />
                                        <Setter Target="Content.Opacity" Value="0.7" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Secondary, sitting on a card: an opaque capsule with a hairline, so glass never stacks on glass. -->
    <Style x:Key="MuOnGlassButtonStyle" TargetType="Button" BasedOn="{StaticResource MuCapsuleButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource MuSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource MuTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>
