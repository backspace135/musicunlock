<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicUnlock">

    <!-- 透镜层始终在段内容之前，按压和挤压分层，避免动画互相覆盖。 -->
    <Style TargetType="local:GlassSwitch">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GlassSwitch">
                    <Grid x:Name="Track" Background="Transparent">
                        <local:GlassSurface x:Name="TrackGlass" Kind="Control" Radius="-1" IsHitTestVisible="False" />
                        <Rectangle x:Name="TrackFill" Fill="{ThemeResource MuTextBrush}" Opacity="0.06"
                                   RadiusX="100" RadiusY="100" IsHitTestVisible="False" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid x:Name="LensHost" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Grid x:Name="LensPress">
                                    <Grid x:Name="LensSquash">
                                        <Grid x:Name="LensShadow" />
                                        <local:GlassSurface x:Name="LensGlass" Kind="Control" Radius="-1" TintOpacity="0.08" />
                                        <Rectangle x:Name="LensFill" RadiusX="100" RadiusY="100" />
                                    </Grid>
                                </Grid>
                            </Grid>
                            <Grid x:Name="Segments" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
