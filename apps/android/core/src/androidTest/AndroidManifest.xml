<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Stands in for a file manager's documents in the import and output tests. -->
        <provider
            android:name="io.github.backspace135.musicunlock.core.TestDocumentsProvider"
            android:authorities="io.github.backspace135.musicunlock.core.test.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>

</manifest>
